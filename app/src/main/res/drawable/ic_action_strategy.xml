<?xml version="1.0" encoding="utf-8"?>
<!-- Target icon for the game menu's Strategy guide entry: two
     concentric rings and a centre dot — aim, in the same line style
     as the other action icons. ?attr/colorControlNormal fill/stroke
     so it follows day/night like the other vector icons. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="?attr/colorControlNormal"
        android:strokeWidth="1.7"
        android:pathData="M12,3 a9,9 0 1,0 0,18 a9,9 0 1,0 0,-18 M12,6.8 a5.2,5.2 0 1,0 0,10.4 a5.2,5.2 0 1,0 0,-10.4"/>
    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M12,10.1 a1.9,1.9 0 1,0 0,3.8 a1.9,1.9 0 1,0 0,-3.8"/>
</vector>
